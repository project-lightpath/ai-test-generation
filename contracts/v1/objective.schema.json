{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-lightpath.github.io/ai-test-generation/contracts/v1/objective.schema.json",
  "title": "ATG test objective",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "version", "objective_id", "statement", "kind", "priority", "acceptance", "evidence_refs"],
  "properties": {
    "contract": { "const": "atg.objective" },
    "version": { "$ref": "common.schema.json#/$defs/contract_version" },
    "objective_id": { "$ref": "common.schema.json#/$defs/id" },
    "statement": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["regression", "behavior", "security", "compatibility", "coverage"] },
    "driver_type": { "enum": ["pull_request", "dependency_change", "vulnerability", "bug_report", "contract_change", "test_gap", "user_objective", "scheduled"] },
    "priority": { "enum": ["low", "medium", "high", "critical"] },
    "test_level": { "enum": ["unit", "component", "integration", "contract", "e2e"] },
    "setup": { "type": "array", "items": { "type": "string" } },
    "action": { "type": "array", "items": { "type": "string" } },
    "oracle": { "type": "array", "items": { "type": "string" } },
    "cleanup": { "type": "array", "items": { "type": "string" } },
    "acceptance": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "evidence_refs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/id" }, "uniqueItems": true },
    "requested_evidence": { "type": "array", "items": { "enum": ["execution", "differential", "mutation", "stability", "coverage", "provenance"] }, "uniqueItems": true },
    "target_refs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/id" }, "uniqueItems": true },
    "exclusions": { "type": "array", "items": { "type": "string" } },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "gaps": { "type": "array", "items": { "type": "string" } }
  }
}
