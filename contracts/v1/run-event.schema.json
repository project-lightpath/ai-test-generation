{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-lightpath.github.io/ai-test-generation/contracts/v1/run-event.schema.json",
  "title": "ATG run-state event",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "version", "event_id", "run_id", "event_type", "expected_revision", "occurred_at"],
  "properties": {
    "contract": { "const": "atg.run_event" },
    "version": { "$ref": "common.schema.json#/$defs/contract_version" },
    "event_id": { "$ref": "common.schema.json#/$defs/id" },
    "run_id": { "$ref": "common.schema.json#/$defs/id" },
    "event_type": { "enum": ["admit", "admission_blocked", "analysis_started", "analysis_completed", "analysis_blocked", "analysis_inconclusive", "checkpoint_created", "checkpoint_expired", "decision_recorded", "planning_completed", "plan_submitted", "generation_started", "generation_completed", "execution_started", "execution_completed", "quality_passed", "quality_blocked", "quality_inconclusive", "quality_gap", "retry_requested", "return_to_analyze", "return_to_plan", "return_to_code", "return_to_execute", "cancel"] },
    "expected_revision": { "type": "integer", "minimum": 0 },
    "occurred_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "checkpoint_id": { "$ref": "common.schema.json#/$defs/id" },
    "checkpoint_kind": { "enum": ["analysis_review", "plan_review", "code_review", "execution_review", "quality_review"] },
    "decision": { "enum": ["approved", "rejected", "blocked", "stated_gap"] },
    "supersedes": { "$ref": "common.schema.json#/$defs/id" },
    "reason": { "type": "string", "minLength": 1 },
    "actor_id": { "$ref": "common.schema.json#/$defs/id" },
    "actor_role": { "type": "string", "minLength": 1 },
    "authorization_ref": { "$ref": "common.schema.json#/$defs/id" },
    "decision_id": { "$ref": "common.schema.json#/$defs/id" },
    "expires_at": { "$ref": "common.schema.json#/$defs/timestamp" }
    ,"plan_id": { "$ref": "common.schema.json#/$defs/id" }
    ,"plan_revision": { "type": "integer", "minimum": 1 }
    ,"plan_artifact_id": { "$ref": "common.schema.json#/$defs/id" }
    ,"plan_artifact_digest": { "$ref": "common.schema.json#/$defs/digest" }
     ,"feedback_id": { "$ref": "common.schema.json#/$defs/id" }
     ,"generation_id": { "$ref": "common.schema.json#/$defs/id" }
     ,"artifact_id": { "$ref": "common.schema.json#/$defs/id" }
     ,"artifact_digest": { "$ref": "common.schema.json#/$defs/digest" }
  },
  "allOf": [
    {
      "oneOf": [
        {
          "properties": { "event_type": { "const": "checkpoint_created" } },
          "required": ["checkpoint_id", "checkpoint_kind"]
        },
        {
          "properties": { "event_type": { "const": "decision_recorded" } },
          "required": ["checkpoint_id", "decision", "decision_id", "actor_id", "actor_role", "authorization_ref"]
        },
        {
          "properties": { "event_type": { "const": "checkpoint_expired" } },
          "required": ["checkpoint_id"]
        },
        {
          "properties": { "event_type": { "const": "cancel" } },
          "required": ["reason"]
        },
        {
          "properties": { "event_type": { "const": "retry_requested" } },
          "required": ["reason"]
        },
        {
          "properties": { "event_type": { "enum": ["return_to_analyze", "return_to_plan", "return_to_code", "return_to_execute"] } },
          "required": ["reason"]
        },
        {
          "properties": { "event_type": { "const": "admission_blocked" } },
          "required": ["reason"]
        },
        {
          "properties": { "event_type": { "enum": ["analysis_blocked", "analysis_inconclusive"] } },
          "required": ["reason"]
        },
         {
           "properties": { "event_type": { "const": "plan_submitted" } },
           "required": ["plan_id", "plan_revision", "plan_artifact_id", "plan_artifact_digest"]
         },
         {
           "properties": { "event_type": { "const": "generation_started" } },
           "required": ["generation_id"]
         },
         {
           "properties": { "event_type": { "const": "generation_completed" } },
           "required": ["generation_id", "artifact_id", "artifact_digest"]
         },
        {
          "properties": {
            "event_type": {
               "enum": ["admit", "analysis_started", "analysis_completed", "planning_completed", "execution_started", "execution_completed", "quality_passed", "quality_blocked", "quality_inconclusive", "quality_gap"]
            }
          }
        }
      ]
    },
    {
      "if": { "properties": { "event_type": { "const": "return_to_plan" } } },
      "then": { "required": ["feedback_id"] }
    }
  ]
}
