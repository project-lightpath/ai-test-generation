{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-lightpath.github.io/ai-test-generation/contracts/v1/run-admission.schema.json",
  "title": "ATG run admission result",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "version", "admission_id", "request_id", "run_id", "evaluated_at", "checks", "status", "request_digest"],
  "properties": {
    "contract": { "const": "atg.run_admission" },
    "version": { "$ref": "common.schema.json#/$defs/contract_version" },
    "admission_id": { "$ref": "common.schema.json#/$defs/id" },
    "request_id": { "$ref": "common.schema.json#/$defs/id" },
    "run_id": { "$ref": "common.schema.json#/$defs/id" },
    "evaluated_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "checks": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/preflight_check" } },
    "status": { "$ref": "common.schema.json#/$defs/admission_status" },
    "request_digest": { "$ref": "common.schema.json#/$defs/payload_digest" },
    "platform_readiness_id": { "$ref": "common.schema.json#/$defs/id" },
    "failure_register_refs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/id" } },
    "reason": { "type": "string", "minLength": 1 },
    "limitations": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/limitation" } },
    "identities": { "$ref": "common.schema.json#/$defs/identity_bundle" }
  },
  "allOf": [
    { "if": { "properties": { "status": { "const": "admitted" } } }, "then": { "properties": { "checks": { "not": { "contains": { "properties": { "required_check": { "const": true }, "status": { "enum": ["fail", "not_run"] } }, "required": ["required_check", "status"] } } } } } },
    { "if": { "properties": { "status": { "enum": ["blocked", "rejected"] } } }, "then": { "required": ["reason"] } }
  ]
}
