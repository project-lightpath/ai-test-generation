{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-lightpath.github.io/ai-test-generation/contracts/v1/analysis.schema.json",
  "title": "ATG repository analysis manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "version", "analysis_id", "run_id", "request_id", "revision",
    "analyzed_at", "subject", "outcome", "evidence_refs", "objective_refs",
    "provenance_ref", "artifact_refs", "findings", "assumptions", "gaps"
  ],
  "properties": {
    "contract": { "const": "atg.analysis" },
    "version": { "$ref": "common.schema.json#/$defs/contract_version" },
    "analysis_id": { "$ref": "common.schema.json#/$defs/id" },
    "run_id": { "$ref": "common.schema.json#/$defs/id" },
    "request_id": { "$ref": "common.schema.json#/$defs/id" },
    "revision": { "type": "integer", "minimum": 0 },
    "analyzed_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "subject": { "$ref": "common.schema.json#/$defs/identity" },
    "profile_digest": { "$ref": "common.schema.json#/$defs/digest" },
    "outcome": {
      "enum": ["validated", "needs_human_review", "blocked", "not_evaluable", "inconclusive", "stated_gap"]
    },
    "evidence_refs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/id" }, "uniqueItems": true },
    "objective_refs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/id" }, "uniqueItems": true },
    "provenance_ref": { "$ref": "common.schema.json#/$defs/id" },
    "artifact_refs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/id" }, "uniqueItems": true },
    "fact_summary": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fact_id", "origin", "claim", "evidence_refs"],
        "properties": {
          "fact_id": { "$ref": "common.schema.json#/$defs/id" },
          "origin": { "enum": ["supplied", "discovered", "inferred"] },
          "claim": { "type": "string", "minLength": 1 },
          "evidence_refs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/id" }, "minItems": 1, "uniqueItems": true }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id", "kind", "description"],
        "properties": {
          "finding_id": { "$ref": "common.schema.json#/$defs/id" },
          "kind": { "enum": ["missing", "stale", "conflicting", "ambiguous", "unsupported", "unauthorized", "incomplete"] },
          "description": { "type": "string", "minLength": 1 },
          "evidence_refs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/id" }, "uniqueItems": true },
          "resolution": { "type": "string", "minLength": 1 }
        }
      }
    },
    "assumptions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "gaps": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "limitations": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/limitation" } }
  },
  "allOf": [
    {
      "if": { "properties": { "outcome": { "const": "validated" } } },
      "then": { "required": ["profile_digest"] }
    }
  ]
}
