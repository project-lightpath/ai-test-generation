{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-lightpath.github.io/ai-test-generation/contracts/v1/signed-differential.schema.json",
  "title": "ATG signed differential result",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "version", "differential_id", "run_id", "request_id", "base_execution_id", "candidate_execution_id", "outcome", "comparisons", "quality_id", "provenance_id", "review_and_signoff"],
  "properties": {
    "contract": { "const": "atg.signed_differential" },
    "version": { "$ref": "common.schema.json#/$defs/contract_version" },
    "differential_id": { "$ref": "common.schema.json#/$defs/id" },
    "run_id": { "$ref": "common.schema.json#/$defs/id" },
    "request_id": { "$ref": "common.schema.json#/$defs/id" },
    "plan_id": { "$ref": "common.schema.json#/$defs/id" },
    "generation_id": { "$ref": "common.schema.json#/$defs/id" },
    "base_execution_id": { "$ref": "common.schema.json#/$defs/id" },
    "candidate_execution_id": { "$ref": "common.schema.json#/$defs/id" },
    "outcome": { "$ref": "common.schema.json#/$defs/outcome" },
    "comparisons": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "base", "candidate", "classification"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "base": {},
          "candidate": {},
          "classification": { "enum": ["same", "changed", "missing", "inconclusive"] },
          "evidence_refs": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/id" } }
        }
      }
    },
    "quality_id": { "$ref": "common.schema.json#/$defs/id" },
    "provenance_id": { "$ref": "common.schema.json#/$defs/id" },
    "test_artifacts": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/artifact" } },
    "test_equivalence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification"],
      "properties": {
        "classification": { "enum": ["exact", "equivalent", "different", "inconclusive"] },
        "base_digest": { "$ref": "common.schema.json#/$defs/payload_digest" },
        "candidate_digest": { "$ref": "common.schema.json#/$defs/payload_digest" },
        "reason": { "type": "string" }
      }
    },
    "environment_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "candidate", "matched"],
      "properties": {
        "base": { "$ref": "common.schema.json#/$defs/identity" },
        "candidate": { "$ref": "common.schema.json#/$defs/identity" },
        "matched": { "type": "boolean" },
        "differences": { "type": "array", "items": { "type": "string" } }
      }
    },
    "review_and_signoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer", "decision", "decided_at", "limitations_acknowledged"],
      "properties": {
        "reviewer": { "$ref": "common.schema.json#/$defs/reviewer" },
        "decision": { "enum": ["approved", "rejected", "needs_human_review"] },
        "decided_at": { "$ref": "common.schema.json#/$defs/timestamp" },
        "limitations_acknowledged": { "type": "boolean" },
        "rationale": { "type": "string" }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "signed_payload_digest", "value", "signed_at"],
      "properties": {
        "algorithm": { "type": "string", "minLength": 1 },
        "key_id": { "$ref": "common.schema.json#/$defs/id" },
        "signed_payload_digest": { "$ref": "common.schema.json#/$defs/payload_digest" },
        "payload_format": { "type": "string", "minLength": 1 },
        "public_key_ref": { "$ref": "common.schema.json#/$defs/id" },
        "value": { "type": "string", "minLength": 1 },
        "signed_at": { "$ref": "common.schema.json#/$defs/timestamp" }
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "payload_type", "verification_status"],
      "properties": {
        "format": { "enum": ["dsse", "in_toto", "other"] },
        "payload_type": { "type": "string", "minLength": 1 },
        "verification_status": { "enum": ["verified", "unverified", "failed", "not_available"] },
        "verification_ref": { "$ref": "common.schema.json#/$defs/id" }
      }
    },
    "limitations": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/limitation" } }
  },
  "allOf": [
    {
      "if": { "properties": { "outcome": { "enum": ["validated", "reproduced", "fixed_behavior"] } } },
      "then": {
        "properties": {
          "comparisons": {
            "contains": {
              "type": "object",
              "required": ["classification"],
              "properties": { "classification": { "enum": ["same", "changed"] } }
            }
          }
        }
      }
    }
  ]
}
