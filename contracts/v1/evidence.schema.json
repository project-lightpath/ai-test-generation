{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-lightpath.github.io/ai-test-generation/contracts/v1/evidence.schema.json",
  "title": "ATG evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "version", "evidence_id", "category", "subject", "source", "observed_at", "claims"],
  "properties": {
    "contract": { "const": "atg.evidence" },
    "version": { "$ref": "common.schema.json#/$defs/contract_version" },
    "evidence_id": { "$ref": "common.schema.json#/$defs/id" },
    "category": { "enum": ["vex", "policy", "repository", "test", "execution", "review", "environment"] },
    "subject": { "$ref": "common.schema.json#/$defs/identity" },
    "source": { "$ref": "common.schema.json#/$defs/source" },
    "observed_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "content_digest": { "$ref": "common.schema.json#/$defs/digest" },
    "claims": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "artifacts": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/artifact" }, "uniqueItems": true },
    "limitations": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/limitation" } }
  }
}
