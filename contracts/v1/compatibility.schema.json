{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-lightpath.github.io/ai-test-generation/contracts/v1/compatibility.schema.json",
  "title": "ATG contract compatibility result",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "version", "compatibility_id", "contract_name", "from_version", "to_version", "compatible", "tested_at"],
  "properties": {
    "contract": { "const": "atg.compatibility" },
    "version": { "$ref": "common.schema.json#/$defs/contract_version" },
    "compatibility_id": { "$ref": "common.schema.json#/$defs/id" },
    "contract_name": { "type": "string", "minLength": 1 },
    "from_version": { "type": "string", "minLength": 1 },
    "to_version": { "type": "string", "minLength": 1 },
    "compatible": { "type": "boolean" },
    "breaking_changes": { "type": "array", "items": { "type": "string" } },
    "migration": { "type": "string" },
    "tested_at": { "$ref": "common.schema.json#/$defs/timestamp" }
  }
}
